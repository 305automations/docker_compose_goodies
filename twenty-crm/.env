# =========================================
# Twenty CRM Environment Configuration
# Managed by 305 Automations
# =========================================

# -----------------------------------------
# DOMAIN CONFIGURATION
# -----------------------------------------

SERVER_URL=https://crm.yourdomain.com
FRONT_BASE_URL=https://crm.yourdomain.com

# -----------------------------------------
# SECURITY
# -----------------------------------------

# Generate with:
# openssl rand -base64 32

APP_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET

# -----------------------------------------
# DATABASE
# -----------------------------------------

PG_DATABASE_HOST=postgres
PG_DATABASE_PORT=5432
PG_DATABASE_USER=twenty
PG_DATABASE_PASSWORD=CHANGE_THIS_PASSWORD
PG_DATABASE_DB=default

# -----------------------------------------
# REDIS
# -----------------------------------------

REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------
# STORAGE
# -----------------------------------------

STORAGE_TYPE=local

# -----------------------------------------
# EMAIL SMTP
# -----------------------------------------

EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=Your Company

EMAIL_SYSTEM_ADDRESS=noreply@yourdomain.com

EMAIL_DRIVER=smtp

EMAIL_SMTP_HOST=smtp.yourprovider.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=noreply@yourdomain.com
EMAIL_SMTP_PASSWORD=CHANGE_THIS_PASSWORD
EMAIL_SMTP_SECURE=true

# -----------------------------------------
# AUTH
# -----------------------------------------

AUTH_PASSWORD_ENABLED=true

# -----------------------------------------
# AI FEATURES
# -----------------------------------------

OPENAI_API_KEY=

# -----------------------------------------
# LOGGING
# -----------------------------------------

LOG_LEVEL=info

# -----------------------------------------
# OPTIONAL GOOGLE MAPS API
# Used for custom lead discovery workflows
# -----------------------------------------

GOOGLE_MAPS_API_KEY=

# -----------------------------------------
# OPTIONAL SCRAPING SERVICES
# -----------------------------------------

SCRAPER_USER_AGENT=305AutomationsBot/1.0

# -----------------------------------------
# TIMEZONE
# -----------------------------------------

TZ=America/New_York