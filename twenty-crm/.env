# ==============================================================================
# TWENTY CRM - PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================
# This file provides the runtime configuration for the docker-compose.yml stack.
# Keep this file secure and NEVER commit it to version control.

# ------------------------------------------------------------------------------
# 1. CORE NETWORKING & ROUTING
# ------------------------------------------------------------------------------
# The base URL where your CRM will be accessible (e.g., https://crm.yourdomain.com)
SERVER_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# These credentials initialize the Alpine PostgreSQL database container.
PG_DATABASE_USER=twenty_user
PG_DATABASE_PASSWORD=SuperSecure_DB_Password_Prod_2026!
PG_DATABASE_NAME=twenty_prod
# The host matches the container name in docker-compose.yml
PG_DATABASE_HOST=twenty-db
PG_DATABASE_PORT=5432

# ------------------------------------------------------------------------------
# 3. CACHE CONFIGURATION (Redis)
# ------------------------------------------------------------------------------
# The internal Redis connection string (matches the container name)
REDIS_URL=redis://twenty-redis:6379

# ------------------------------------------------------------------------------
# 4. SECURITY & CRYPTOGRAPHY (CRITICAL)
# ------------------------------------------------------------------------------
# ENCRYPTION_KEY: Must be a secure, random 256-bit key (64 hex characters).
# Used to encrypt sensitive data like tokens and credentials at rest in the DB.
ENCRYPTION_KEY=a7a25d682fa818804e7f0027996880e94fc3ea08fba4df1911edacca82421736

# FALLBACK_ENCRYPTION_KEY: Used during key rotation. Leave blank for fresh installs.
FALLBACK_ENCRYPTION_KEY=

# APP_SECRET: Used to sign session cookies and JWTs. Must be long and random.
APP_SECRET=185078984c089470696a26d00a0d4101f7892e2f80c4c800ff2554719deaa166

# ------------------------------------------------------------------------------
# 5. STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# Set to 'local' to use the docker volume, or 's3' for object storage
STORAGE_TYPE=local

# S3 Configuration (Uncomment and fill if STORAGE_TYPE=s3)
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_NAME=my-twenty-prod-bucket
# STORAGE_S3_ENDPOINT=

# ------------------------------------------------------------------------------
# 6. APP LIFECYCLE CONTROLS
# ------------------------------------------------------------------------------
# These are handled securely by the compose file (workers are disabled, server is enabled),
# but you can override them globally here if doing manual maintenance.
DISABLE_DB_MIGRATIONS=false
DISABLE_CRON_JOBS_REGISTRATION=false

# ------------------------------------------------------------------------------
# OPTIONAL: THIRD PARTY INTEGRATIONS (Uncomment to activate)
# ------------------------------------------------------------------------------

# --- Google Workspace ---
# MESSAGING_PROVIDER_GMAIL_ENABLED=true
# CALENDAR_PROVIDER_GOOGLE_ENABLED=true
# AUTH_GOOGLE_CLIENT_ID=your_google_client_id
# AUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret
# AUTH_GOOGLE_CALLBACK_URL=${SERVER_URL}/auth/google/callback
# AUTH_GOOGLE_APIS_CALLBACK_URL=${SERVER_URL}/auth/google/apis/callback

# --- Microsoft 365 ---
# CALENDAR_PROVIDER_MICROSOFT_ENABLED=true
# MESSAGING_PROVIDER_MICROSOFT_ENABLED=true
# AUTH_MICROSOFT_ENABLED=true
# AUTH_MICROSOFT_CLIENT_ID=your_microsoft_client_id
# AUTH_MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
# AUTH_MICROSOFT_CALLBACK_URL=${SERVER_URL}/auth/microsoft/callback
# AUTH_MICROSOFT_APIS_CALLBACK_URL=${SERVER_URL}/auth/microsoft/apis/callback

# --- Outbound Email (SMTP) ---
# EMAIL_FROM_ADDRESS=crm@yourdomain.com
# EMAIL_FROM_NAME="Twenty CRM"
# EMAIL_DRIVER=smtp
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_USER=your_smtp_user
# EMAIL_SMTP_PASSWORD=your_smtp_password